# AI_API_KEY: Required for AI API calls (OpenAI-compatible).
# Funciona con cualquier proveedor compatible con /v1/chat/completions:
#   - Groq:      https://console.groq.com/keys
#   - OpenAI:    https://platform.openai.com/api-keys
#   - OpenRouter:https://openrouter.ai/keys
AI_API_KEY="MY_AI_API_KEY"

# AI_BASE_URL: (OPCIONAL) Endpoint base del proveedor.
# Por defecto apunta a Groq. Ejemplos:
#   Groq:      https://api.groq.com/openai/v1/chat/completions
#   OpenAI:    https://api.openai.com/v1/chat/completions
#   OpenRouter:https://openrouter.ai/api/v1/chat/completions
AI_BASE_URL=""

# AI_MODELS: Modelos a probar en orden, separados por coma.
# El primero responde; si falla (429/error) se intenta el siguiente.
# Ej. OpenAI: "gpt-4o,gpt-4o-mini" | OpenRouter: "openai/gpt-4o,anthropic/claude-3.5-sonnet"
AI_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"

# Compatibilidad retroactiva: si no defines AI_*, se usan estas variables Groq.
GROQ_API_KEY=""
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"

# FEED_MAX_HOURS: Solo se procesan entradas de RSS menores a este número de horas (evita noticias viejas).
FEED_MAX_HOURS="24"

# RSS_BUNDLE: URL del feed RSS/Atom de donde salen las noticias.
# Si no se pasa ?url=, /api/feed-proxy usa esta URL. Mismo valor que los bots de Discord.
RSS_BUNDLE=""

# AI_RATE_PER_MIN: Límite de llamadas IA (geolocate + análisis) por minuto por IP.
# Protege la cuota de Groq si el servicio queda público.
AI_RATE_PER_MIN="60"

# API_ACCESS_TOKEN: OPCIONAL. Si se define, los endpoints internos (/api/geolocate,
# /api/ai-analyze-alert y /api/classify-batch) exigen la cabecera X-Access-Token con
# este valor. Ten en cuenta que la interfaz web también debería enviarla.
# Déjalo vacío si no lo vas a usar: el rate limit ya protege la cuota.
API_ACCESS_TOKEN=""

# APP_URL: URL pública donde está desplegada la app (en Vercel se inyecta automáticamente).
# Puedes dejarla vacía; se usa como referencia para enlaces auto-referenciales.
APP_URL=""